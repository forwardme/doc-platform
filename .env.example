# 管理员账号（首次启动即生效，可随时修改）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please

# 可选：直接提供 bcrypt 哈希（优先级高于 ADMIN_PASSWORD）
# 生成方式：node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" yourpassword
# ADMIN_PASSWORD_HASH=

# 会话 JWT 密钥，务必改成随机长字符串
AUTH_SECRET=please-change-this-to-a-long-random-string

# 数据存储目录（文件 + SQLite），默认 ./data
# DATA_DIR=./data

# 服务端口
# PORT=3000

# LibreOffice 可执行文件路径（可选，默认自动查找 soffice）
# SOFFICE_PATH=soffice
